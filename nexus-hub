local HB_PARTS = {"HumanoidRootPart","Head","UpperTorso","LowerTorso","Torso"}
local function hbExpand(p)
    if not p:IsA("BasePart") then return end
    if not State.HitboxOriginals[p] then
        State.HitboxOriginals[p] = {Size=p.Size, Transparency=p.Transparency, CanCollide=p.CanCollide,
            CanTouch=p.CanTouch, CanQuery=p.CanQuery, Massless=p.Massless, Shape=p:IsA("Part") and p.Shape or nil}
    end
    local o = State.HitboxOriginals[p]
    p.Size = o.Size * Config.HitboxSize
    p.Transparency = 1
    p.CanCollide = false
    p.CanTouch = true
    p.CanQuery = false
    p.Massless = true
    if p:IsA("Part") then pcall(function() p.Shape = Enum.PartType.Ball end) end
end
local function hbRestore(p)
    if not p or not p.Parent then return end
    local o = State.HitboxOriginals[p]
    if not o then return end
    pcall(function()
        p.Size, p.Transparency, p.CanCollide = o.Size, o.Transparency, o.CanCollide
        p.CanTouch, p.CanQuery, p.Massless = o.CanTouch, o.CanQuery, o.Massless
        if o.Shape and p:IsA("Part") then p.Shape = o.Shape end
    end)
    State.HitboxOriginals[p] = nil
end
task.spawn(function()
