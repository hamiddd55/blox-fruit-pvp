    State.Humanoid = c:WaitForChild("Humanoid", 10)
    if State.Root then
        State.FlyBV = State.Root:FindFirstChild("NEXUS_FlyBV")
        State.FlyBG = State.Root:FindFirstChild("NEXUS_FlyBG")
