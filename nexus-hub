local faLast = setmetatable({}, {__mode="k"})
local function faParts(t)
    local p = {}
    for _, c in ipairs(t:GetChildren()) do
        if c:IsA("BasePart") then p[#p+1] = {t, c} end
    end
    return p
end
local function fireFA(t)
    if not t or not t.Parent then return end
    local now = tick()
    if faLast[t] and now - faLast[t] < 0.1 then return end
    faLast[t] = now
    local hrp = t:FindFirstChild("HumanoidRootPart")
    if not hrp or not getNet() then return end
    local atk = ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack")
    local hit = ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")
    if not atk or not hit then return end
    local parts = faParts(t)
    if #parts == 0 then return end
    pcall(function() atk:FireServer(); hit:FireServer(hrp, parts) end)
end
local faFrame = 0
