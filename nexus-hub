-- ============ SILENT AIM v2 ============
if has.getrawmetatable and has.hookmetamethod and has.setreadonly then
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if Config.SilentAim2 and (key == "Hit" or key == "Target") and self == lp:GetMouse() then
                local best, bestDist = nil, 500
                local center = camera.ViewportSize / 2
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local part = p.Character:FindFirstChild("Head")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if part and hum and hum.Health > 0 then
                            local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                if dist < bestDist then
                                    bestDist = dist
                                    best = part
                                end
                            end
                        end
                    end
                end
                if best then
                    if key == "Hit" then return best.CFrame end
                    if key == "Target" then return best end
                end
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end)
    if not ok then warn("[NEXUS] Silent Aim v2 hook failed") end
end

