                            local part = pl.Character:FindFirstChild(name)
                            if part then hbExpand(part) end
                        end
                    end
                end
            end
        end
    end
end)

local function saGetTarget()
    if not State.Root then return nil end
    local mousePos = UserInputService:GetMouseLocation()
    local closest, closestDist = nil, Config.SilentAimFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local skip = false
            if Config.SilentAimTeamCheck and p.Team and lp.Team and p.Team == lp.Team then skip = true end
            if not skip then
                local part = p.Character:FindFirstChild(Config.SilentAimPart)
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if part and hum and hum.Health > 0 then
                    local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = {part = part, char = p.Character}
                        end
                    end
                end
            end
        end
    end
    return closest
end

if has.getrawmetatable and has.hookmetamethod then
    local ok, err = pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if Config.SilentAim and (self == camera or tostring(self):find("Camera")) and key == "CFrame" then
                local t = saGetTarget()
                if t and t.part then
                    return CFrame.new(camera.CFrame.Position, t.part.Position)
                end
            end
            return oldIndex(self, key)
        end)
    end)
    if not ok then warn("[NEXUS] Silent Aim hook failed:", err) end
end

if has.getrawmetatable and has.setreadonly then
    pcall(function()
        local mt = getrawmetatable(game)
        if mt and mt.__index then
            local oldIndex = mt.__index
            setreadonly(mt, false)
            mt.__index = newcclosure(function(self, key)
                if Config.SilentAim2 and (key == "Hit" or key == "Target") and self == lp:GetMouse() then
                    local best, bestDist = nil, 500
                    local center = camera.ViewportSize / 2
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= lp and p.Character then
                            local part = p.Character:FindFirstChild("Head")
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if part and hum and hum.Health > 0 then
                                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                                if onScreen then
                                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                    if dist < bestDist then
                                        bestDist = dist
                                        best = part
                                    end
                                end
                            end
                        end
                    end
                    if best then
                        if key == "Hit" then return best.CFrame end
                        if key == "Target" then return best end
                    end
                end
                return oldIndex(self, key)
            end)
            setreadonly(mt, true)
        end
    end)
end

