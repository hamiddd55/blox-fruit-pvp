-- TP NPCs LOOP
-- ═══════════════════════════════════════════════════════════
local function GetAllNPCs()
    local list = {}
    local folder = workspace:FindFirstChild(Config.TPNPCFolder)
    if not folder then return list end
    local myRoot = getRoot()
    if not myRoot then return list end

    for _, npc in ipairs(folder:GetChildren()) do
        if npc:IsA("Model") then
            local hum = npc:FindFirstChildOfClass("Humanoid")
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - myRoot.Position).Magnitude
                if dist <= Config.TPNPCRange then
                    list[#list+1] = {model = npc, hrp = hrp, hum = hum, dist = dist}
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function StartTPNPCs()
    if State.TPNPCThread then task.cancel(State.TPNPCThread) end
    State.TPNPCThread = task.spawn(function()
        while Config.TPNPCs do
            local npcs = GetAllNPCs()
            local myRoot = getRoot()
            if not myRoot then
                task.wait(0.5)
            elseif #npcs == 0 then
                task.wait(0.5)
            else
                for _, t in ipairs(npcs) do
                    if not Config.TPNPCs then break end
                    if not t.hrp or not t.hrp.Parent then continue end
                    if not t.hum or t.hum.Health <= 0 then continue end
                    local root = getRoot()
                    if root then
                        root.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                        root.Velocity = Vector3.zero
                    end
                    local endTime = tick() + Config.TPNPCDelay
                    while tick() < endTime and Config.TPNPCs do
                        local root2 = getRoot()
                        if root2 and t.hrp and t.hrp.Parent then
                            root2.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                            root2.Velocity = Vector3.zero
                        end
                        task.wait(0.05)
                    end
                end
            end
        end
    end)
end

local function StopTPNPCs()
    if State.TPNPCThread then
        task.cancel(State.TPNPCThread)
        State.TPNPCThread = nil
    end
end

