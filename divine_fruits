local function makePage(name)
    local p = Instance.new("ScrollingFrame", PageContainer)
    p.Name = name
    p.Size = UDim2.new(1, 0, 1, 0)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.ScrollBarThickness = 3
    p.ScrollBarImageColor3 = Config.ThemeColor
    p.CanvasSize = UDim2.new(0, 0, 0, 0)
    p.AutomaticCanvasSize = Enum.AutomaticSize.Y
    p.Visible = false
    local l = Instance.new("UIListLayout", p)
    l.Padding = UDim.new(0, 6)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    local u = Instance.new("UIPadding", p)
    u.PaddingRight = UDim.new(0, 6)
    u.PaddingBottom = UDim.new(0, 12)
    return p
end

local function makeTab(name, order)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size = UDim2.new(0, 0, 0, 24)
    btn.AutomaticSize = Enum.AutomaticSize.X
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(180, 180, 190)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.LayoutOrder = order

    local p = Instance.new("UIPadding", btn)
    p.PaddingLeft = UDim.new(0, 10)
    p.PaddingRight = UDim.new(0, 10)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local page = makePage(name)
    Pages[name] = page
    TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function()
        for n, pg in pairs(Pages) do pg.Visible = (n == name) end
        for n, b in pairs(TabButtons) do
            if n == name then
                TweenService:Create(b, TweenInfo.new(0.2),
                    {BackgroundColor3 = Config.ThemeColor, TextColor3 = Color3.fromRGB(10, 10, 15)}):Play()
            else
                TweenService:Create(b, TweenInfo.new(0.2),
                    {BackgroundColor3 = Color3.fromRGB(28, 28, 36), TextColor3 = Color3.fromRGB(180, 180, 190)}):Play()
            end
        end
    end)
end

