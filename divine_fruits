-- ═══════════════════════════════════════════════════════════
local function HopToBestServer()
    pcall(function()
        print("[SASING] 🚀 Hop to best server...")

        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Asc&limit=100"
        local ok, data = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)

        if not ok or not data or not data.data then
            print("[SASING] ❌ API failed, hopping random")
            TeleportService:Teleport(game.PlaceId, lp)
            return
        end

        local candidates = {}
        for _, server in ipairs(data.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                local pingScore = (server.ping and server.ping > 0) and server.ping or 9999
                local playerScore = server.playing * 2
                table.insert(candidates, {
                    id = server.id,
                    score = pingScore + playerScore,
                    ping = server.ping or 0,
                    playing = server.playing,
                })
            end
        end

        if #candidates == 0 then
            print("[SASING] ❌ No servers found")
            TeleportService:Teleport(game.PlaceId, lp)
            return
        end

        table.sort(candidates, function(a, b) return a.score < b.score end)
        local best = candidates[1]
        print("[SASING] ✅ Best:", best.ping, "ms |", best.playing, "players")
        TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, lp)
    end)
end

