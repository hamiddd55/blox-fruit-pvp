local function GetPlayerTargets()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                list[#list+1] = {hrp = hrp}
            end
        end
    end
    return list
end

local function StartTPPlayers()
    if State.TPLoopThread then task.cancel(State.TPLoopThread) end
    State.TPLoopThread = task.spawn(function()
        while Config.TPPlayers do
            local targets = GetPlayerTargets()
            if #targets == 0 then
                task.wait(0.5)
            else
                for _, t in ipairs(targets) do
                    if not Config.TPPlayers then break end
                    if not t.hrp or not t.hrp.Parent then continue end
                    local myHRP = getRoot()
                    if myHRP then
                        myHRP.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                        myHRP.Velocity = Vector3.zero
                    end
                    local endTime = tick() + Config.TPStick
                    while tick() < endTime and Config.TPPlayers do
                        local root = getRoot()
                        if root and t.hrp and t.hrp.Parent then
                            root.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                            root.Velocity = Vector3.zero
                        end
                        task.wait(0.05)
                    end
                end
            end
        end
    end)
end

local function StopTPPlayers()
    if State.TPLoopThread then
        task.cancel(State.TPLoopThread)
        State.TPLoopThread = nil
    end
end

