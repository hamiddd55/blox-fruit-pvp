--[[
    SASING HUB | AFK FULL AUTO — FINAL
    - Auto Team Select (Pirates) on execute + after every hop
    - Auto Equip Fruit
    - Fruit Fast Attack
    - TP to Players Loop (0.5s per player)
    - Auto Server Hop every 40s
    - All runs automatically — no button needed
--]]

-- ═══════════════════════════════════════════════════════════
-- SERVICES
-- ═══════════════════════════════════════════════════════════
local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local TeleportService    = game:GetService("TeleportService")
local HttpService        = game:GetService("HttpService")
local lp                 = Players.LocalPlayer

-- ═══════════════════════════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════════════════════════
getgenv().SASING_AFK_MODE       = true
getgenv().SASING_HOP_INTERVAL   = 40
getgenv().SASING_FRUIT_DELAY    = 0.15
getgenv().SASING_TP_STICK       = 0.5      -- ✅ 0.5 ثانية
getgenv().SASING_TEAM_CHECK     = false
getgenv().SASING_AUTO_TEAM      = true
getgenv().SASING_PREFERRED_TEAM = "Pirates"

-- ═══════════════════════════════════════════════════════════
-- NET REMOTES
-- ═══════════════════════════════════════════════════════════
local RegisterHit, RegisterAttack
task.spawn(function()
    pcall(function()
        local Net = ReplicatedStorage:WaitForChild("Modules", 10):WaitForChild("Net", 10)
        RegisterHit    = Net:WaitForChild("RE/RegisterHit", 10)
        RegisterAttack = Net:WaitForChild("RE/RegisterAttack", 10)
    end)
end)

-- ═══════════════════════════════════════════════════════════
-- STATE
-- ═══════════════════════════════════════════════════════════
local FruitAttackConnection = nil
local TPLoopThread          = nil
local AutoHopThread         = nil
local AutoEquipThread       = nil
local AutoTeamThread        = nil

-- ═══════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════
local function getRoot()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isFruit(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool.ToolTip == "Blox Fruit" then return true end
    if tool.Name:lower():find("fruit") then return true end
    local fruitNames = {
        "dough","dragon","kitsune","leopard","venom","control",
        "spirit","shadow","buddha","rumble","portal","pain",
        "blizzard","gravity","mammoth","tiger","t-rex","gas",
        "yeti","sound","phoenix","magma","ice","light","dark",
        "flame","sand","bomb","spike","spring","chop","smoke"
    }
    for _, f in ipairs(fruitNames) do
        if tool.Name:lower():find(f) then return true end
    end
    return false
end

local function autoEquipFruit()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and isFruit(currentTool) then return end

    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isFruit(t) then
                pcall(function() hum:EquipTool(t) end)
                return
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- AUTO TEAM
-- ═══════════════════════════════════════════════════════════
local function selectTeam(teamName)
    pcall(function()
        if lp.Team and lp.Team.Name ~= "" then
            print("[SASING] Already in team:", lp.Team.Name)
            return
        end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            pcall(function() commF:InvokeServer("SetTeam", teamName) end)
            print("[SASING] Team set:", teamName)
        end
    end)
end

local function StartAutoTeam()
    if AutoTeamThread then task.cancel(AutoTeamThread) end

    AutoTeamThread = task.spawn(function()
        task.wait(2)
        if not getgenv().SASING_AUTO_TEAM then return end
        selectTeam(getgenv().SASING_PREFERRED_TEAM)

        for i = 1, 12 do
            task.wait(5)
            if not getgenv().SASING_AUTO_TEAM then return end

            if lp.Team and lp.Team.Name ~= "" then
                print("[SASING] Team confirmed:", lp.Team.Name)
                return
            end
            selectTeam(getgenv().SASING_PREFERRED_TEAM)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- FRUIT ATTACK
-- ═══════════════════════════════════════════════════════════
local function GetNearestPlayer()
    local myHRP = getRoot()
    if not myHRP then return nil end

    local nearest, dist = nil, math.huge
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= lp and v.Character then
            local hrp = v.Character:FindFirstChild("HumanoidRootPart")
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local skip = false
                if getgenv().SASING_TEAM_CHECK and v.Team and lp.Team and v.Team == lp.Team then
                    skip = true
                end
                if not skip then
                    local d = (myHRP.Position - hrp.Position).Magnitude
                    if d < dist then dist = d; nearest = v end
                end
            end
        end
    end
    return nearest
end

local function FireEquippedFruit(direction, char)
    pcall(function()
        if not char then return end
        local dir = Vector3.new(direction.X, direction.Y, direction.Z)

        local fruits = {
            {"Pain-Pain",       function(r) for i=1,5 do r:FireServer(dir,1,true) end end},
            {"Dragon-Dragon",   function(r) for i=1,5 do r:FireServer(dir,1)      end end},
            {"Tiger-Tiger",     function(r) for i=1,5 do r:FireServer(dir,3)      end end},
            {"T-Rex-T-Rex",     function(r) for i=1,5 do r:FireServer(dir,1)      end end},
            {"Kitsune-Kitsune", function(r) for i=1,5 do r:FireServer(direction,1,true) end end},
        }
        for _, entry in ipairs(fruits) do
            local fruitModel = char:FindFirstChild(entry[1])
            if fruitModel then
                local remote = fruitModel:FindFirstChild("LeftClickRemote")
                if remote then entry[2](remote) end
                return
            end
        end
    end)
end

local function StartFruitAttack()
    if FruitAttackConnection then FruitAttackConnection:Disconnect() end
    FruitAttackConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().SASING_AFK_MODE then return end
        if not (RegisterHit and RegisterAttack) then return end

        task.wait(getgenv().SASING_FRUIT_DELAY)

        pcall(function()
            local target = GetNearestPlayer()
            if not (target and target.Character) then return end

            local char = lp.Character
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
            local tHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not (myHRP and tHRP and tHum and tHum.Health > 0) then return end

            local direction = (tHRP.Position - myHRP.Position).Unit
            FireEquippedFruit(direction, char)

            local head = target.Character:FindFirstChild("Head")
            if head then
                RegisterAttack:FireServer(0)
                RegisterHit:FireServer(head, {{target.Character, head}})
            end
        end)
    end)
end

local function StartAutoEquip()
    if AutoEquipThread then task.cancel(AutoEquipThread) end
    AutoEquipThread = task.spawn(function()
        while getgenv().SASING_AFK_MODE do
            task.wait(1)
            autoEquipFruit()
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- TP LOOP (0.5s per player)
-- ═══════════════════════════════════════════════════════════
local function GetPlayerTargets()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                list[#list+1] = {hrp = hrp}
            end
        end
    end
    return list
end

local function StartTPLoop()
    if TPLoopThread then task.cancel(TPLoopThread) end
    TPLoopThread = task.spawn(function()
        while getgenv().SASING_AFK_MODE do
            local targets = GetPlayerTargets()
            if #targets == 0 then
                task.wait(0.5)
            else
                for _, t in ipairs(targets) do
                    if not getgenv().SASING_AFK_MODE then break end
                    if not t.hrp or not t.hrp.Parent then continue end

                    local myHRP = getRoot()
                    if myHRP then
                        myHRP.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                        myHRP.Velocity = Vector3.zero
                    end

                    local endTime = tick() + getgenv().SASING_TP_STICK
                    while tick() < endTime and getgenv().SASING_AFK_MODE do
                        local root = getRoot()
                        if root and t.hrp and t.hrp.Parent then
                            root.CFrame = CFrame.new(t.hrp.Position + Vector3.new(0, 3, 0))
                            root.Velocity = Vector3.zero
                        end
                        task.wait(0.05)
                    end
                end
            end
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- AUTO HOP
-- ═══════════════════════════════════════════════════════════
local function hopServer()
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        if data and data.data then
            for _, v in ipairs(data.data) do
                if v.playing < v.maxPlayers and v.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, v.id, lp)
                    return
                end
            end
        end
        TeleportService:Teleport(game.PlaceId, lp)
    end)
end

local function StartAutoHop()
    if AutoHopThread then task.cancel(AutoHopThread) end
    AutoHopThread = task.spawn(function()
        while getgenv().SASING_AFK_MODE do
            task.wait(getgenv().SASING_HOP_INTERVAL)
            if getgenv().SASING_AFK_MODE then
                print("[SASING] Hopping...")
                hopServer()
                break
            end
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- MASTER START
-- ═══════════════════════════════════════════════════════════
local function StartEverything()
    getgenv().SASING_AFK_MODE = true
    task.wait(2)

    print("[SASING] Starting Auto Team...")
    StartAutoTeam()

    task.wait(4)

    autoEquipFruit()
    StartFruitAttack()
    StartAutoEquip()
    StartTPLoop()
    StartAutoHop()

    print("[SASING] ✅ ALL SYSTEMS ON")
    print("[SASING] Team:", getgenv().SASING_PREFERRED_TEAM)
    print("[SASING] TP Stick:", getgenv().SASING_TP_STICK, "s")
    print("[SASING] Next hop in", getgenv().SASING_HOP_INTERVAL, "s")
end

