local function remotes()
    if not ReplicatedStorage then
        return nil
    end
    return ReplicatedStorage:FindFirstChild("Remotes")
end

local function commF()
    local folder = remotes()
    return folder and folder:FindFirstChild("CommF_")
end

local function invokeRemote(...)
    local remote = commF()
    if not remote then
        return false
    end
    local args = table.pack(...)
    local ok, err = pcall(function()
        remote:InvokeServer(table.unpack(args, 1, args.n))
    end)
    if not ok then
        warn("[Kanna Hub] remote error: " .. tostring(err))
    end
    return ok
end

local function redeemRemote(code)
    local folder = remotes()
    local remote = folder and folder:FindFirstChild("Redeem")
    if not remote then
        return false
    end
    local ok, err = pcall(function()
        remote:InvokeServer(tostring(code))
    end)
    if not ok then
        warn("[Kanna Hub] redeem error: " .. tostring(err))
    end
    return ok
end

