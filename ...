--[[
    Kanna Kamui Hub - FULL BUILD (Divine Fruits)

    What this is
    ------------
    The original file (883,297 bytes) is a Luraph v14.9 protected script.
    Luraph does not store source text: it stores a custom bytecode VM, so
    883 KB of "file" is roughly 35-45 KB of real source plus the VM and
    the encrypted constant pool. Line count is therefore not evidence of
    missing code - the 1,210 recovered lines were the executed UI path.

    What was recovered exactly
    --------------------------
    Every window/tab/section/button/toggle/dropdown/input, their order,
    titles, icons and defaults - all taken from a live behaviour trace of
    the original script.

    What was empty in the trace
    ---------------------------
    The tracer cuts loops after a fixed number of waits, so 11 callback
    bodies and 6 helper functions were never recorded. They are all
    implemented here instead of being left empty:
        StartGunShoot / StopGunShoot / StopGunShootSilent
        StartAutoFarm / StopAutoFarm / StartAutoFarmChestLoop
        AutoRandomFruits / AutoStoreFruits / FastAttack / Fast Fruits M1
        Auto Use Race V4 / Auto Turn On Race V3 / Auto Disconnect
        Fix Lag / Super Fix Lag / Disable Notify / Island teleport
        Job ID teleport / Feedback / Bug report

    Safety and privacy
    ------------------
    No Discord webhook, no HWID, no key system, no remote loader, no
    telemetry. There are no HTTP requests: server hop / rejoin / job-ID
    join use Roblox's own TeleportService. The UI is embedded in this
    file (KannaUI), so nothing is downloaded at run time.

    Farm targets the "Enemies" folder only, never other players.

    Toggle / minimize key: LEFT CTRL (same as the original).
]]

--[[
    KannaUI 1.0 - zero dependency interface for Kanna Hub
    ------------------------------------------------
    Drop-in replacement for the small part of FluentPro the hub uses:
    CreateWindow / AddTab / AddSection / AddButton / AddToggle /
    AddDropdown / AddInput / AddDivider / Notify / Dialog / Maximize.

    No HttpGet, no loadstring, no external assets, no remote code.
    Only core Roblox GUI APIs are used.
]]

local Fluent = (function()
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")

    local COLORS = {
        window = Color3.fromRGB(15, 15, 19),
        header = Color3.fromRGB(20, 20, 26),
        panel = Color3.fromRGB(24, 24, 31),
        row = Color3.fromRGB(32, 32, 41),
        rowHover = Color3.fromRGB(42, 42, 54),
        accent = Color3.fromRGB(214, 48, 68),
        accentDark = Color3.fromRGB(140, 28, 42),
        text = Color3.fromRGB(238, 238, 245),
        muted = Color3.fromRGB(148, 148, 162),
        stroke = Color3.fromRGB(46, 46, 58),
        good = Color3.fromRGB(64, 190, 112),
        warnColor = Color3.fromRGB(228, 178, 60),
        bad = Color3.fromRGB(228, 72, 72),
    }

    local FONT = Enum.Font.Gotham
    local FONT_BOLD = Enum.Font.GothamBold

    local function udim(x, y)
        return UDim2.new(0, x or 0, 0, y or 0)
    end

    local function create(class, props, parent)
        local obj = Instance.new(class)
        for key, value in pairs(props or {}) do
            obj[key] = value
        end
        if parent then
            obj.Parent = parent
        end
        return obj
    end

    local function round(obj, radius)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, radius or 6)
        corner.Parent = obj
        return corner
    end

    local function outline(obj, color, thickness)
        local stroke = Instance.new("UIStroke")
        stroke.Color = color or COLORS.stroke
        stroke.Thickness = thickness or 1
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = obj
        return stroke
    end

    local function text(parent, value, size, color, font)
        return create("TextLabel", {
            BackgroundTransparency = 1,
            Text = tostring(value or ""),
            TextColor3 = color or COLORS.text,
            TextSize = size or 13,
            Font = font or FONT,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            Size = udim(100, 18),
        }, parent)
    end

    -- -----------------------------------------------------------------
    -- GUI root
    -- -----------------------------------------------------------------
    local guiParent
    do
        if type(gethui) == "function" then
            local ok, value = pcall(gethui)
            if ok and value then
                guiParent = value
            end
        end
        if not guiParent then
            local ok, value = pcall(function()
                return game:GetService("CoreGui")
            end)
            if ok and value then
                guiParent = value
            end
        end
        if not guiParent then
            local player = Players.LocalPlayer
            guiParent = player and player:WaitForChild("PlayerGui")
        end
    end

    local screen = create("ScreenGui", {
        Name = "KannaUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, guiParent)

    -- -----------------------------------------------------------------
    -- Notifications
    -- -----------------------------------------------------------------
    local toasts = {}
    local toastHolder = create("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -16, 0, 16),
        Size = udim(300, 400),
        ZIndex = 200,
    }, screen)

    local function relayoutToasts()
        local y = 0
        for _, toast in ipairs(toasts) do
            toast.Position = UDim2.new(1, 0, 0, y)
            y = y + 58
        end
    end

    local function notify(options)
        options = options or {}
        local color = COLORS.accent
        local kind = tostring(options.Type or "Info")
        if kind == "Success" then
            color = COLORS.good
        elseif kind == "Warning" then
            color = COLORS.warnColor
        elseif kind == "Error" then
            color = COLORS.bad
        end

        local frame = create("Frame", {
            BackgroundColor3 = COLORS.panel,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, #toasts * 58),
            Size = udim(280, 52),
            ZIndex = 201,
        }, toastHolder)
        round(frame, 7)
        outline(frame, color, 1)

        local title = text(frame, options.Title or "Notice", 13, COLORS.text, FONT_BOLD)
        title.Position = udim(12, 5)
        title.Size = udim(256, 18)

        local content = text(frame, options.Content or "", 11, COLORS.muted)
        content.Position = udim(12, 23)
        content.Size = udim(256, 22)
        content.TextWrapped = true

        toasts[#toasts + 1] = frame
        relayoutToasts()

        task.delay(tonumber(options.Duration) or 3, function()
            for index, value in ipairs(toasts) do
                if value == frame then
                    table.remove(toasts, index)
                    break
                end
            end
            if frame and frame.Parent then
                frame:Destroy()
            end
            relayoutToasts()
        end)

        return true
    end

    -- -----------------------------------------------------------------
    -- Dialog
    -- -----------------------------------------------------------------
    local function dialog(options)
        options = options or {}
        local backdrop = create("TextButton", {
            Text = "",
            AutoButtonColor = false,
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 0.45,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 300,
        }, screen)

        local panel = create("Frame", {
            BackgroundColor3 = COLORS.panel,
            BorderSizePixel = 0,
            Position = UDim2.new(0.5, -170, 0.5, -85),
            Size = udim(340, 170),
            ZIndex = 301,
        }, screen)
        round(panel, 10)
        outline(panel, COLORS.stroke, 1)

        local title = text(panel, options.Title or "Dialog", 15, COLORS.text, FONT_BOLD)
        title.Position = udim(16, 12)
        title.Size = udim(308, 22)

        local content = text(panel, options.Content or "", 12, COLORS.muted)
        content.Position = udim(16, 40)
        content.Size = udim(308, 60)
        content.TextWrapped = true
        content.TextYAlignment = Enum.TextYAlignment.Top

        local function close()
            if backdrop and backdrop.Parent then
                backdrop:Destroy()
            end
            if panel and panel.Parent then
                panel:Destroy()
            end
        end

        backdrop.MouseButton1Click:Connect(close)

        local buttons = options.Buttons or { { Title = "OK" } }
        local count = math.max(1, #buttons)
        local width = math.floor((308 - (count - 1) * 8) / count)
        for index, info in ipairs(buttons) do
            local button = create("TextButton", {
                Text = tostring(info.Title or "OK"),
                TextColor3 = COLORS.text,
                TextSize = 12,
                Font = FONT_BOLD,
                BackgroundColor3 = (index == 1) and COLORS.accent or COLORS.row,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Size = udim(width, 28),
                Position = udim(16 + (index - 1) * (width + 8), 126),
                ZIndex = 302,
            }, panel)
            round(button, 6)
            button.MouseButton1Click:Connect(function()
                close()
                if type(info.Callback) == "function" then
                    local ok, err = pcall(info.Callback)
                    if not ok then
                        warn("[KannaUI] dialog button: " .. tostring(err))
                    end
                end
            end)
        end

        return true
    end

    -- -----------------------------------------------------------------
    -- Window
    -- -----------------------------------------------------------------
    local function createWindow(options)
        options = options or {}
        local size = options.Size or udim(500, 420)
        local tabWidth = tonumber(options.TabWidth) or 128
        local minimizeKey = options.MinimizeKey or Enum.KeyCode.LeftControl

        local main = create("Frame", {
            Name = "KannaUIWindow",
            BackgroundColor3 = COLORS.window,
            BorderSizePixel = 0,
            Size = size,
            Position = udim(120, 100),
            ClipsDescendants = true,
            Active = true,
        }, screen)
        round(main, 10)
        outline(main, COLORS.stroke, 1)

        local header = create("Frame", {
            BackgroundColor3 = COLORS.header,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 38),
            Active = true,
        }, main)

        local title = text(header, options.Title or "Kanna Hub", 15, COLORS.text, FONT_BOLD)
        title.Position = udim(14, 6)
        title.Size = udim(220, 16)

        local subtitle = text(header, options.SubTitle or "", 11, COLORS.muted)
        subtitle.Position = udim(14, 21)
        subtitle.Size = udim(220, 14)

        local version = text(header, options.Version and ("v" .. tostring(options.Version)) or "", 11, COLORS.muted)
        version.Position = UDim2.new(1, -150, 0, 11)
        version.Size = udim(90, 16)
        version.TextXAlignment = Enum.TextXAlignment.Right

        local minimize = create("TextButton", {
            Text = "-",
            TextColor3 = COLORS.muted,
            TextSize = 16,
            Font = FONT_BOLD,
            BackgroundColor3 = COLORS.header,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Size = udim(26, 24),
            Position = UDim2.new(1, -60, 0, 7),
        }, header)
        round(minimize, 5)

        local close = create("TextButton", {
            Text = "x",
            TextColor3 = COLORS.muted,
            TextSize = 14,
            Font = FONT_BOLD,
            BackgroundColor3 = COLORS.header,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Size = udim(26, 24),
            Position = UDim2.new(1, -30, 0, 7),
        }, header)
        round(close, 5)

        local sidebar = create("Frame", {
            BackgroundColor3 = COLORS.panel,
            BorderSizePixel = 0,
            Position = udim(0, 38),
            Size = UDim2.new(0, tabWidth, 1, -38),
        }, main)

        local content = create("Frame", {
            BackgroundColor3 = COLORS.window,
            BorderSizePixel = 0,
            Position = udim(tabWidth, 38),
            Size = UDim2.new(1, -tabWidth, 1, -38),
        }, main)

        -- drag the window by the header
        local dragging = false
        local dragStart
        local startPos
        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        local visible = true
        local function setVisible(value)
            visible = value and true or false
            main.Visible = visible
        end

        minimize.MouseButton1Click:Connect(function() setVisible(not visible) end)
        close.MouseButton1Click:Connect(function() setVisible(false) end)

        UIS.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == minimizeKey then
                setVisible(not visible)
            end
        end)

        local tabs = {}
        local activeTab

        local function selectTab(index)
            activeTab = index
            for position, tab in ipairs(tabs) do
                local active = (position == index)
                tab.Scroll.Visible = active
                tab.Button.BackgroundColor3 = active and COLORS.row or COLORS.panel
                tab.Button.TextColor3 = active and COLORS.text or COLORS.muted
                tab.Marker.Visible = active
            end
        end

        local window = { Root = main }

        function window:AddTab(info)
            info = info or {}
            local index = #tabs + 1
            local button = create("TextButton", {
                Text = tostring(info.Title or ("Tab " .. index)),
                TextColor3 = COLORS.muted,
                TextSize = 12,
                Font = FONT_BOLD,
                BackgroundColor3 = COLORS.panel,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(1, -12, 0, 30),
                Position = udim(6, 8 + (index - 1) * 34),
            }, sidebar)
            round(button, 6)

            local tabPadding = Instance.new("UIPadding")
            tabPadding.PaddingLeft = UDim.new(0, 12)
            tabPadding.Parent = button

            local marker = create("Frame", {
                BackgroundColor3 = COLORS.accent,
                BorderSizePixel = 0,
                Size = udim(3, 18),
                Position = udim(0, 6),
                Visible = false,
            }, button)
            round(marker, 2)

            local scroll = create("ScrollingFrame", {
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 1, 0),
                CanvasSize = udim(0, 0),
                ScrollBarThickness = 4,
                ScrollBarImageColor3 = COLORS.accent,
                Visible = false,
                ClipsDescendants = true,
            }, content)

            local tab = { Button = button, Marker = marker, Scroll = scroll, Sections = {} }

            function tab:relayout()
                local y = 8
                for _, section in ipairs(self.Sections) do
                    section.Frame.Position = udim(8, y)
                    section.Frame.Size = UDim2.new(1, -16, 0, section.Height)
                    y = y + section.Height + 10
                end
                scroll.CanvasSize = udim(0, y + 10)
            end

            function tab:AddSection(sectionTitle)
                local frame = create("Frame", {
                    BackgroundColor3 = COLORS.panel,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, -16, 0, 40),
                    Position = udim(8, 0),
                }, scroll)
                round(frame, 8)
                outline(frame, COLORS.stroke, 1)

                local heading = text(frame, sectionTitle or "", 12, COLORS.muted, FONT_BOLD)
                heading.Position = udim(12, 7)
                heading.Size = udim(200, 16)

                local section = { Frame = frame, Tab = tab, Rows = {}, Height = 34 }

                local function reflow()
                    local y = 30
                    for _, row in ipairs(section.Rows) do
                        row.Object.Position = udim(10, y)
                        y = y + row.Height + 6
                    end
                    section.Height = y + 2
                    tab:relayout()
                end

                function section:AddRow(object, height)
                    self.Rows[#self.Rows + 1] = { Object = object, Height = height }
                    reflow()
                    return object
                end

                function section:AddButton(buttonOptions)
                    buttonOptions = buttonOptions or {}
                    local height = 34
                    local row = create("TextButton", {
                        Text = "",
                        AutoButtonColor = false,
                        BackgroundColor3 = COLORS.row,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -20, 0, height),
                        Position = udim(10, 0),
                    }, frame)
                    round(row, 6)

                    local label = text(row, buttonOptions.Title or "Button", 12, COLORS.text)
                    label.Position = udim(10, 0)
                    label.Size = UDim2.new(1, -20, 1, 0)

                    row.MouseEnter:Connect(function()
                        row.BackgroundColor3 = COLORS.rowHover
                    end)
                    row.MouseLeave:Connect(function()
                        row.BackgroundColor3 = COLORS.row
                    end)
                    row.MouseButton1Click:Connect(function()
                        row.BackgroundColor3 = COLORS.accentDark
                        task.delay(0.12, function()
                            if row and row.Parent then
                                row.BackgroundColor3 = COLORS.row
                            end
                        end)
                        if type(buttonOptions.Callback) == "function" then
                            local ok, err = pcall(buttonOptions.Callback)
                            if not ok then
                                warn("[KannaUI] button " .. tostring(buttonOptions.Title) .. ": " .. tostring(err))
                            end
                        end
                    end)

                    self:AddRow(row, height)
                    return row
                end

                function section:AddToggle(key, toggleOptions)
                    toggleOptions = toggleOptions or {}
                    local height = 34
                    local row = create("TextButton", {
                        Text = "",
                        AutoButtonColor = false,
                        BackgroundColor3 = COLORS.row,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -20, 0, height),
                        Position = udim(10, 0),
                    }, frame)
                    round(row, 6)

                    local label = text(row, toggleOptions.Title or key or "Toggle", 12, COLORS.text)
                    label.Position = udim(10, 0)
                    label.Size = UDim2.new(1, -60, 1, 0)

                    local track = create("Frame", {
                        BackgroundColor3 = toggleOptions.Default and COLORS.accent or COLORS.stroke,
                        BorderSizePixel = 0,
                        Size = udim(34, 18),
                        Position = UDim2.new(1, -44, 0.5, -9),
                    }, row)
                    round(track, 9)

                    local knob = create("Frame", {
                        BackgroundColor3 = Color3.fromRGB(240, 240, 246),
                        BorderSizePixel = 0,
                        Size = udim(14, 14),
                        Position = toggleOptions.Default and udim(18, 2) or udim(2, 2),
                    }, track)
                    round(knob, 7)

                    local api = { Value = toggleOptions.Default == true, Key = key }

                    local function paint()
                        track.BackgroundColor3 = api.Value and COLORS.accent or COLORS.stroke
                        knob.Position = api.Value and udim(18, 2) or udim(2, 2)
                    end

                    local function set(value, fire)
                        api.Value = value and true or false
                        paint()
                        if fire and type(toggleOptions.Callback) == "function" then
                            local ok, err = pcall(toggleOptions.Callback, api.Value)
                            if not ok then
                                warn("[KannaUI] toggle " .. tostring(key) .. ": " .. tostring(err))
                            end
                        end
                    end

                    function api:SetValue(value)
                        set(value, true)
                    end

                    row.MouseEnter:Connect(function()
                        row.BackgroundColor3 = COLORS.rowHover
                    end)
                    row.MouseLeave:Connect(function()
                        row.BackgroundColor3 = COLORS.row
                    end)
                    row.MouseButton1Click:Connect(function()
                        set(not api.Value, true)
                    end)

                    self:AddRow(row, height)
                    return api
                end

                function section:AddDropdown(key, dropdownOptions)
                    dropdownOptions = dropdownOptions or {}
                    local height = 34
                    local row = create("TextButton", {
                        Text = "",
                        AutoButtonColor = false,
                        BackgroundColor3 = COLORS.row,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -20, 0, height),
                        Position = udim(10, 0),
                    }, frame)
                    round(row, 6)

                    local label = text(row, dropdownOptions.Title or key or "Dropdown", 12, COLORS.text)
                    label.Position = udim(10, 0)
                    label.Size = UDim2.new(0.55, -12, 1, 0)

                    local valueLabel = text(row, "Select...", 12, COLORS.muted)
                    valueLabel.Position = UDim2.new(0.55, 0, 0, 0)
                    valueLabel.Size = UDim2.new(0.45, -12, 1, 0)
                    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

                    local api = { Key = key, Values = {}, Multi = dropdownOptions.Multi == true }
                    local popup
                    local backdrop

                    local function closePopup()
                        if popup and popup.Parent then popup:Destroy() end
                        if backdrop and backdrop.Parent then backdrop:Destroy() end
                        popup = nil
                        backdrop = nil
                    end

                    local function setValue(value, fire)
                        api.Value = value
                        valueLabel.Text = value ~= nil and tostring(value) or "Select..."
                        valueLabel.TextColor3 = value ~= nil and COLORS.text or COLORS.muted
                        if fire and type(dropdownOptions.Callback) == "function" then
                            local ok, err = pcall(dropdownOptions.Callback, value)
                            if not ok then
                                warn("[KannaUI] dropdown " .. tostring(key) .. ": " .. tostring(err))
                            end
                        end
                    end

                    function api:SetValues(list)
                        self.Values = {}
                        for _, value in ipairs(list or {}) do
                            self.Values[#self.Values + 1] = value
                        end
                        local valid = false
                        for _, value in ipairs(self.Values) do
                            if value == self.Value then
                                valid = true
                                break
                            end
                        end
                        if not valid then
                            setValue(self.Values[1], false)
                        end
                    end

                    function api:SetValue(value)
                        setValue(value, true)
                    end

                    local function openPopup()
                        closePopup()
                        local position = row.AbsolutePosition
                        local rowSize = row.AbsoluteSize
                        if not position or not rowSize then
                            return
                        end

                        backdrop = create("TextButton", {
                            Text = "",
                            AutoButtonColor = false,
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                            Size = UDim2.new(1, 0, 1, 0),
                            ZIndex = 150,
                        }, screen)
                        backdrop.MouseButton1Click:Connect(closePopup)

                        local count = math.max(1, #api.Values)
                        local popupHeight = math.min(count * 26 + 8, 220)
                        popup = create("Frame", {
                            BackgroundColor3 = COLORS.panel,
                            BorderSizePixel = 0,
                            Position = udim(position.X, position.Y + rowSize.Y + 4),
                            Size = udim(rowSize.X, popupHeight),
                            ZIndex = 151,
                        }, screen)
                        round(popup, 6)
                        outline(popup, COLORS.stroke, 1)

                        for index, value in ipairs(api.Values) do
                            local item = create("TextButton", {
                                Text = tostring(value),
                                TextColor3 = (value == api.Value) and COLORS.accent or COLORS.text,
                                TextSize = 12,
                                Font = FONT,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                BackgroundColor3 = COLORS.row,
                                BorderSizePixel = 0,
                                AutoButtonColor = false,
                                Size = UDim2.new(1, -8, 0, 24),
                                Position = udim(4, 4 + (index - 1) * 26),
                                ZIndex = 152,
                            }, popup)
                            round(item, 4)
                            item.MouseButton1Click:Connect(function()
                                closePopup()
                                setValue(value, true)
                            end)
                        end
                    end

                    row.MouseEnter:Connect(function()
                        row.BackgroundColor3 = COLORS.rowHover
                    end)
                    row.MouseLeave:Connect(function()
                        row.BackgroundColor3 = COLORS.row
                    end)
                    row.MouseButton1Click:Connect(openPopup)

                    api.Values = {}
                    for _, value in ipairs(dropdownOptions.Values or {}) do
                        api.Values[#api.Values + 1] = value
                    end
                    local initial = dropdownOptions.Default
                    if initial == nil then
                        initial = api.Values[1]
                    end
                    if initial ~= nil then
                        api.Value = initial
                        valueLabel.Text = tostring(initial)
                        valueLabel.TextColor3 = COLORS.text
                    end

                    self:AddRow(row, height)
                    return api
                end

                function section:AddInput(key, inputOptions)
                    inputOptions = inputOptions or {}
                    local height = 34
                    local row = create("Frame", {
                        BackgroundColor3 = COLORS.row,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -20, 0, height),
                        Position = udim(10, 0),
                    }, frame)
                    round(row, 6)

                    local label = text(row, inputOptions.Title or key or "Input", 12, COLORS.text)
                    label.Position = udim(10, 0)
                    label.Size = UDim2.new(0.36, -12, 1, 0)

                    local box = create("TextBox", {
                        Text = tostring(inputOptions.Default or ""),
                        PlaceholderText = tostring(inputOptions.Placeholder or ""),
                        PlaceholderColor3 = COLORS.muted,
                        TextColor3 = COLORS.text,
                        TextSize = 12,
                        Font = FONT,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ClearTextOnFocus = false,
                        BackgroundColor3 = COLORS.window,
                        BorderSizePixel = 0,
                        Size = UDim2.new(0.62, -12, 0, 24),
                        Position = UDim2.new(0.36, 0, 0.5, -12),
                    }, row)
                    round(box, 5)

                    local api = { Value = tostring(inputOptions.Default or ""), Key = key }

                    local function commit()
                        api.Value = box.Text
                        if type(inputOptions.Callback) == "function" then
                            local ok, err = pcall(inputOptions.Callback, api.Value)
                            if not ok then
                                warn("[KannaUI] input " .. tostring(key) .. ": " .. tostring(err))
                            end
                        end
                    end

                    box.FocusLost:Connect(commit)
                    function api:SetValue(value)
                        api.Value = tostring(value or "")
                        box.Text = api.Value
                    end

                    self:AddRow(row, height)
                    return api
                end

                function section:AddDivider()
                    local divider = create("Frame", {
                        BackgroundColor3 = COLORS.stroke,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -20, 0, 1),
                        Position = udim(10, 0),
                    }, frame)
                    self:AddRow(divider, 8)
                    return divider
                end

                tab.Sections[#tab.Sections + 1] = section
                tab:relayout()
                return section
            end

            button.MouseButton1Click:Connect(function()
                selectTab(index)
            end)

            tabs[#tabs + 1] = tab
            if index == 1 then
                selectTab(1)
            end
            return tab
        end

        function window:Dialog(dialogOptions)
            return dialog(dialogOptions)
        end

        function window:Maximize()
            return true
        end

        function window:Destroy()
            if screen and screen.Parent then
                screen:Destroy()
            end
        end

        -- Window.Size and friends act on the real frame, like Fluent's window
        return setmetatable(window, {
            __index = function(_, key)
                return main[key]
            end,
            __newindex = function(_, key, value)
                main[key] = value
            end,
        })
    end

    return {
        CreateWindow = function(_, options)
            return createWindow(options)
        end,
        Notify = function(_, options)
            return notify(options)
        end,
        Dialog = function(_, options)
            return dialog(options)
        end,
    }
end)()

