-- ---------------------------------------------------------------------------
local GUN_WORDS = {
    "gun", "bow", "rifle", "cannon", "bazooka", "sniper",
    "musket", "pistol", "shotgun", "launcher", "slingshot",
}
local SWORD_WORDS = {
    "sword", "blade", "katana", "cutlass", "saber", "rapier",
    "trident", "spear", "scythe", "axe", "club", "hammer", "whip",
}
local FRUIT_WORDS = { "fruit", "fruit:" }

local function containsAny(name, words)
    for _, word in ipairs(words) do
        if string.find(name, word, 1, true) then
            return true
        end
    end
    return false
end

local function toolKind(tool)
    local name = string.lower(tool.Name)
    if containsAny(name, GUN_WORDS) then
        return "Gun"
    end
    if containsAny(name, FRUIT_WORDS) then
        return "Fruit"
    end
    if containsAny(name, SWORD_WORDS) then
        return "Sword"
    end
    return "Melee"
end

local function allTools()
    local list = {}
    local char = getChar()
    local backpack = getBackpack()
    for _, container in ipairs({ char, backpack }) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Tool") then
                    table.insert(list, child)
                end
            end
        end
    end
    return list
end

local function findTool(kind)
    local equipped
    local fallback
    for _, tool in ipairs(allTools()) do
        local matches = (kind == nil) or (toolKind(tool) == kind)
        if matches then
            if tool.Parent == getChar() then
                equipped = tool
            else
                fallback = fallback or tool
            end
        end
    end
    return equipped or fallback
end

local function equipTool(kind)
    local char = getChar()
    local hum = getHum()
    if not (char and hum) then
        return nil
    end
    local tool = findTool(kind)
    if tool and tool.Parent ~= char then
        pcall(function()
            hum:EquipTool(tool)
        end)
    end
    return tool
end

local function activateTool(kind)
    local tool = equipTool(kind)
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end
    return tool
end

-- ---------------------------------------------------------------------------
-- Enemy helpers
-- ---------------------------------------------------------------------------
local function enemiesFolder()
    return Workspace:FindFirstChild("Enemies")
end

local function mobTarget(mob)
    if not mob then
        return nil
    end
    return mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart")
end

local function nearestMob(maxDistance)
    local folder = enemiesFolder()
    local myRoot = getRoot()
    if not (folder and myRoot) then
        return nil, math.huge
    end
    local best, bestDistance
    for _, mob in ipairs(folder:GetChildren()) do
        local target = mobTarget(mob)
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if target and hum and hum.Health > 0 then
            local distance = (target.Position - myRoot.Position).Magnitude
            if distance <= (maxDistance or 300) and (not bestDistance or distance < bestDistance) then
                best, bestDistance = mob, distance
            end
        end
    end
    return best, bestDistance or math.huge
end

