local Threads = {}
local Connections = {}

local function startThread(name, fn, interval)
    Threads[name] = true
    task.spawn(function()
        while Threads[name] do
            local ok, err = pcall(fn)
            if not ok then
                warn("[Kanna Hub] " .. name .. ": " .. tostring(err))
            end
            task.wait(interval or 0.1)
        end
    end)
end

local function stopThread(name)
    Threads[name] = nil
end

local function isRunning(name)
    return Threads[name] == true
end

local function connect(name, signal, fn)
    if Connections[name] then
        Connections[name]:Disconnect()
    end
    Connections[name] = signal:Connect(fn)
end

local function disconnect(name)
    if Connections[name] then
        Connections[name]:Disconnect()
        Connections[name] = nil
    end
end

