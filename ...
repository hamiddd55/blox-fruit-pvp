local function clickAtWorld(position)
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end
    local ok, screen = pcall(function()
        return camera:WorldToViewportPoint(position)
    end)
    if not ok or not screen then
        return
    end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(screen.X, screen.Y))
    end)
end

local function gunStep()
    local myRoot = getRoot()
    if not myRoot then
        return
    end
    local mob = nearestMob(State.FarmRange)
    local target = mobTarget(mob)
    if not target then
        return
    end
    local flat = Vector3.new(target.Position.X, myRoot.Position.Y, target.Position.Z)
    local away = (flat - target.Position)
    if away.Magnitude < 0.1 then
        away = Vector3.new(0, 0, 1)
    end
    local stand = flat + away.Unit * 26 + Vector3.new(0, 3, 0)
    myRoot.CFrame = CFrame.lookAt(stand, target.Position)
    local tool = equipTool("Gun")
    clickAtWorld(target.Position)
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end
end

local chestCache = {}
local nextChestScan = 0

local function chestStep()
    local myRoot = getRoot()
    if not myRoot then
        return
    end
    local now = os.clock()
    if now >= nextChestScan then
        nextChestScan = now + 1.5
        chestCache = {}
        local map = Workspace:FindFirstChild("Map") or Workspace
        pcall(function()
            local scanned = 0
            for _, obj in ipairs(map:GetDescendants()) do
                scanned = scanned + 1
                if scanned > 4000 then
                    break
                end
                if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "chest", 1, true) then
                    table.insert(chestCache, obj)
                end
            end
        end)
    end
    local chest = chestCache[1]
    if chest and chest.Parent then
        myRoot.CFrame = CFrame.new(chest.Position + Vector3.new(0, 3, 0))
    end
end

