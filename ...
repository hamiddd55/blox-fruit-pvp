end

local function teleportToIsland(name)
    local myRoot = getRoot()
    if not myRoot then
        notify("Teleport", "Character not ready", "Error")
        return
    end
    local needle = string.lower(tostring(name or ""))
    if #needle == 0 then
        notify("Teleport", "Pick an island first", "Error")
        return
    end
    local map = Workspace:FindFirstChild("Map") or Workspace
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), needle, 1, true) then
            local ok, pivot = pcall(function()
                return obj:GetPivot()
            end)
            if ok and pivot then
                myRoot.CFrame = CFrame.new(pivot.Position + Vector3.new(0, 10, 0))
                notify("Teleport", "Teleported to " .. obj.Name, "Success")
                return
            end
        end
    end
    notify("Teleport", "Island not loaded: " .. tostring(name), "Error")
end

local function islandNames()
    local names, seen = {}, {}
    local map = Workspace:FindFirstChild("Map")
    for _, source in ipairs({ map, Workspace }) do
        if source then
            for _, obj in ipairs(source:GetChildren()) do
                if obj:IsA("Model") and not seen[obj.Name] then
                    seen[obj.Name] = true
                    table.insert(names, obj.Name)
                end
            end
        end
    end
    table.sort(names)
    return names
end

